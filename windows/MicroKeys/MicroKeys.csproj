<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows tray app. Builds on macOS/Linux too (EnableWindowsTargeting) so
       the port can be compiled and published from a Mac; it only *runs* on Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AssemblyName>MicroKeys</AssemblyName>
    <RootNamespace>MicroKeys</RootNamespace>
    <ApplicationIcon>Resources/AppIcon.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Single self-contained exe; no .NET runtime install needed on the target machine. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.1.0" />
    <ProjectReference Include="../MicroKeys.Core/MicroKeys.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/AppIcon.ico" LogicalName="AppIcon.ico" />
    <!-- Shared docs ship next to the exe so "Open Documentation" works offline. -->
    <None Include="../../docs/CONFIG.md" Link="docs/CONFIG.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/CONFIG.en.md" Link="docs/CONFIG.en.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../config.example.json" Link="config.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
