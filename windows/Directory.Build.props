<Project>
  <!-- Shared settings for every project under windows/. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The version comes from the repository-level VERSION file, same as the macOS build. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../VERSION').Trim())</Version>
    <Authors>chenguang</Authors>
    <Product>MicroKeys</Product>
    <Copyright>MIT License</Copyright>
  </PropertyGroup>
</Project>
